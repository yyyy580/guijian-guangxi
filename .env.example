# ===== 《桂见广西》环境变量模板 =====
# 使用方法：复制本文件为 .env 并填入真实 Key（.env 已被 .gitignore 排除，严禁提交）

# --- 多模态大模型（多模态识景 / RAG 问答，可换供应商） ---
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4v-flash

# --- TTS 语音合成 ---
TTS_API_KEY=your-tts-api-key
TTS_BASE_URL=

# --- AIGC 图生视频（即梦 / 可灵，生成素材用，不进运行时） ---
VIDEO_API_KEY=your-video-api-key
