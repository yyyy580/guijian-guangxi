# ===== 《桂见广西》环境变量模板 =====
# 使用方法：复制本文件为 .env 并填入真实 Key（.env 已被 .gitignore 排除，严禁提交）
# 后端读取方式：以 Spring Boot 启动前注入的环境变量为准（IDE 运行配置 / set / export）

# --- 多模态大模型（RAG 问答 / 流式讲解 / 识景；供应商可整体替换） ---
# stub=演示模式（无需 Key）；zhipu=智谱 AI
LLM_PROVIDER=stub
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_VISION_MODEL=glm-4v-flash
LLM_EMBEDDING_MODEL=embedding-3

# --- TTS 语音合成（当前朗读走浏览器 speechSynthesis，此为后端 TTS 预留） ---
TTS_PROVIDER=stub
TTS_API_KEY=your-tts-api-key

# --- AIGC 图生视频（即梦 / 可灵，生成素材用，不进运行时） ---
VIDEO_API_KEY=your-video-api-key
